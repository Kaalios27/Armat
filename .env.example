# Armat runs entirely in the browser: there are no secrets and no server settings.
# These optional variables only exist for development (copy to .env.local).

# Shorter study modules for manual testing (minutes; ignored in production builds).
# NEXT_PUBLIC_ARMAT_MODULE_MINUTES=2

# Simulated start date and time for testing schedules (ignored in production builds).
# NEXT_PUBLIC_ARMAT_FAKE_NOW=2026-11-29T10:00:00+01:00

# Base path for GitHub Pages (set by the Pages workflow, for example /Armat).
# PAGES_BASE_PATH=
