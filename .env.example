# Copy to .env.local for local development. Never commit real values.

# --- Database ---------------------------------------------------------------
# PostgreSQL connection string. Leave empty in development to use an embedded
# PGlite database stored in ./.data/pglite. Required in production.
# Supabase: use the "Transaction pooler" URI (port 6543).
DATABASE_URL=

# --- Access control ---------------------------------------------------------
# Password for the single learner account. Required in production.
APP_PASSWORD=
# Random string of at least 32 characters used to sign the session cookie.
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
SESSION_SECRET=

# --- AI provider ------------------------------------------------------------
# anthropic | openai | none. AI features stay off unless this is set explicitly.
AI_PROVIDER=anthropic
ANTHROPIC_API_KEY=
# Optional model override (default: claude-opus-5-5).
ANTHROPIC_MODEL=
OPENAI_API_KEY=
OPENAI_MODEL=
# Price per million tokens for cost tracking when using OpenAI (USD).
OPENAI_PRICE_INPUT_PER_MTOK=
OPENAI_PRICE_OUTPUT_PER_MTOK=

# --- Spending controls ------------------------------------------------------
# Hard caps; AI calls are refused (and the app falls back to curated content)
# once a cap is reached.
AI_DAILY_BUDGET_USD=1.50
AI_MONTHLY_BUDGET_USD=20
AI_MAX_CALLS_PER_MINUTE=12

# --- Text-to-speech (dictation) ---------------------------------------------
# azure | google | browser. "browser" uses the device's Spanish (es-ES) voice.
TTS_PROVIDER=browser
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=
# Default: es-ES-ElviraNeural
AZURE_SPEECH_VOICE=
GOOGLE_TTS_API_KEY=
# Default: es-ES-Neural2-A
GOOGLE_TTS_VOICE=
