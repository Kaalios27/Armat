{
  "name": "armat",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Personal Spanish learning system that runs entirely in the browser: daily vocabulary, conjugation and grammar sessions with weekly examinations.",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "predev": "node scripts/copy-pglite.mjs",
    "dev": "next dev",
    "prebuild": "node scripts/copy-pglite.mjs",
    "build": "next build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:generate": "drizzle-kit generate && node scripts/gen-migrations.mjs"
  },
  "dependencies": {
    "@electric-sql/pglite": "^0.5.17",
    "drizzle-orm": "^0.45.4",
    "geist": "^1.9.2",
    "next": "^16.4.6",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "ts-fsrs": "^6.0.1",
    "zod": "^4.6.7"
  },
  "overrides": {
    "esbuild": "0.28.2"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.5",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "drizzle-kit": "^0.31.11",
    "tailwindcss": "^4.3.5",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^5.1.1"
  }
}
